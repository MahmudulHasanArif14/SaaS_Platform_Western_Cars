# Copy to .env.local and fill in. Never commit real values.
# Validated by src/lib/env (schema.ts). Names follow docs/technical/TRD.md §14.
#
# Use LOCAL / TEST credentials only. Never put staging or production
# credentials in a local file.

# local | test | staging | production (default: local).
# staging and production require every variable in the two blocks below.
APP_ENV=local

# --- public (inlined into the browser bundle) -------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- server only (never prefix with NEXT_PUBLIC_) ---------------------------
SUPABASE_SECRET_KEY=

# --- not validated yet: added to the schema when the module is built --------
# ENCRYPTION_KEY=            # base64, 32 bytes
# ENCRYPTION_KEY_VERSION=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# DOJO_API_KEY=
# DOJO_WEBHOOK_SECRET=
# CLOUDFLARE_API_TOKEN=      # platform-level only; per-org tokens are encrypted in the DB
# EMAIL_API_KEY=
# TURN_SECRET=
# SENTRY_DSN=
# RATE_LIMIT_REDIS_URL=
